{
  "family_id": "release-gate-sample-set",
  "schemas": [
    {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "release-gate-sample-set/v1",
      "type": "object",
      "additionalProperties": false,
      "x-pullwise-digest": {
        "field": "sample_set_digest",
        "domain": "pullwise:release-gate-sample-set:v1"
      },
      "x-pullwise-semantics": {
        "document_rules": ["release_gate_sample_set"],
        "contextual_helpers": []
      },
      "required": [
        "schema_id", "sample_set_id", "package", "candidate_build_id", "candidate_digest",
        "release_mode", "stable_package", "stable_candidate_digest", "stable_control_plane_digest",
        "benchmark_ref", "benchmark_digest", "policy_ref", "policy_digest", "benchmark_version",
        "task_inventory_digest", "oracle_rubric_digest", "environment_image_digest",
        "control_plane_digest", "evaluation_runtime_digest", "statistical_implementation_version",
        "samples", "completed_at", "organization_id", "producer_role", "producer_id",
        "sample_set_digest"
      ],
      "properties": {
        "schema_id": {"const": "release-gate-sample-set/v1"},
        "sample_set_id": {
          "type": "string",
          "pattern": "^release_sample_set_[0-9a-f]{32}$"
        },
        "package": {"$ref": "current-package-ref/v1"},
        "candidate_build_id": {
          "type": "string",
          "pattern": "^candidate_[0-9a-f]{32}$"
        },
        "candidate_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "release_mode": {"enum": ["BOOTSTRAP", "STABLE"]},
        "stable_package": {
          "oneOf": [{"type": "null"}, {"$ref": "current-package-ref/v1"}]
        },
        "stable_candidate_digest": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          ]
        },
        "stable_control_plane_digest": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          ]
        },
        "benchmark_ref": {
          "$ref": "content-ref/v1",
          "x-pullwise-content-schema-id": "benchmark-bundle/v1"
        },
        "benchmark_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "policy_ref": {
          "$ref": "content-ref/v1",
          "x-pullwise-content-schema-id": "release-gate-policy/v1"
        },
        "policy_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "benchmark_version": {
          "type": "string",
          "pattern": "^benchmark-[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "task_inventory_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "oracle_rubric_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "environment_image_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "control_plane_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "evaluation_runtime_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "statistical_implementation_version": {
          "const": "pullwise-release-statistics/v1"
        },
        "samples": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2000000,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sample_id", "cohort", "task_id", "task_kind", "unknown_family_id",
              "cluster_id", "case_category", "criticality", "seed", "profile_id",
              "oracle_in_scope_finding_count", "expected_failure_outcome",
              "disposition", "infrastructure_reason_code", "evidence_issue_codes",
              "observation"
            ],
            "properties": {
              "sample_id": {
                "type": "string",
                "pattern": "^sample_[0-9a-f]{64}$"
              },
              "cohort": {"enum": ["CANDIDATE", "STABLE"]},
              "task_id": {
                "type": "string",
                "pattern": "^benchmark_task_[0-9a-f]{32}$"
              },
              "task_kind": {"enum": ["KNOWN", "UNKNOWN"]},
              "unknown_family_id": {
                "oneOf": [
                  {"type": "null"},
                  {
                    "type": "string",
                    "pattern": "^unknown_[a-z0-9_]{1,64}$"
                  }
                ]
              },
              "cluster_id": {
                "type": "string",
                "pattern": "^cluster_[a-z0-9_]{1,64}$"
              },
              "case_category": {
                "enum": [
                  "ADVERSARIAL_INPUT",
                  "BAD_OR_INCOMPLETE_PATCH",
                  "ENVIRONMENT_OR_CAPABILITY_FAILURE",
                  "FAKE_SUCCESS_OR_ZERO_TEST",
                  "REAL_FIX"
                ]
              },
              "criticality": {"enum": ["CRITICAL", "NON_CRITICAL"]},
              "seed": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
              },
              "profile_id": {
                "type": "string",
                "pattern": "^profile_[a-z0-9_]{1,64}$"
              },
              "oracle_in_scope_finding_count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "expected_failure_outcome": {
                "oneOf": [
                  {"type": "null"},
                  {"enum": ["BLOCKED", "PARTIAL"]}
                ]
              },
              "disposition": {"enum": ["EXCLUDED", "INCLUDED"]},
              "infrastructure_reason_code": {
                "oneOf": [
                  {"type": "null"},
                  {
                    "type": "string",
                    "pattern": "^INFRA_[A-Z0-9_]{1,64}$"
                  }
                ]
              },
              "evidence_issue_codes": {
                "type": "array",
                "minItems": 0,
                "maxItems": 5,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "EVALUATOR_FAILURE",
                    "EVIDENCE_MISSING",
                    "EVIDENCE_STALE",
                    "ORACLE_RUBRIC_CONFLICT",
                    "TIMEOUT"
                  ]
                }
              },
              "observation": {
                "oneOf": [
                  {"type": "null"},
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "terminal_outcome", "hidden_oracle_passed", "human_answer_supplied",
                      "reported_oracle_in_scope_finding_count",
                      "mandatory_requirement_count", "covered_mandatory_requirement_count",
                      "source_state_proof_count", "covered_source_state_proof_count",
                      "safety_authority_violation_count", "stale_publish_count",
                      "duplicate_effect_or_result_count", "wall_ms", "token_count",
                      "cost_microusd"
                    ],
                    "properties": {
                      "terminal_outcome": {
                        "enum": [
                          "BLOCKED", "CANCELLED", "CANCELLED_WITH_EFFECTS",
                          "COMPLETED", "FAILED", "NO_CHANGE_NEEDED", "PARTIAL",
                          "TERMINATED_WITH_UNKNOWN_EFFECTS"
                        ]
                      },
                      "hidden_oracle_passed": {"type": "boolean"},
                      "human_answer_supplied": {"type": "boolean"},
                      "reported_oracle_in_scope_finding_count": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "mandatory_requirement_count": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "covered_mandatory_requirement_count": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "source_state_proof_count": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "covered_source_state_proof_count": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "safety_authority_violation_count": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "stale_publish_count": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "duplicate_effect_or_result_count": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "wall_ms": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "token_count": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "cost_microusd": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    }
                  }
                ]
              }
            },
            "oneOf": [
              {
                "properties": {
                  "disposition": {"const": "INCLUDED"},
                  "infrastructure_reason_code": {"const": null}
                }
              },
              {
                "properties": {
                  "disposition": {"const": "EXCLUDED"},
                  "infrastructure_reason_code": {
                    "type": "string",
                    "pattern": "^INFRA_[A-Z0-9_]{1,64}$"
                  },
                  "evidence_issue_codes": {"maxItems": 0},
                  "observation": {"const": null}
                }
              }
            ]
          }
        },
        "completed_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "organization_id": {
          "type": "string",
          "pattern": "^org_[a-z0-9_]{1,64}$"
        },
        "producer_role": {"const": "ci_evidence_producer"},
        "producer_id": {
          "type": "string",
          "pattern": "^principal_[a-z0-9_]{1,64}$"
        },
        "sample_set_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  ],
