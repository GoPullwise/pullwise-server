      "x-pullwise-semantics": {
        "document_rules": ["agent_task_runtime_bootstrap"],
        "contextual_helpers": []
      },
      "required": [
        "schema_id",
        "package",
        "accept_request",
        "accept_response",
        "authority",
        "transport_binding",
        "construction_roots",
        "bootstrap_digest"
      ],
      "properties": {
        "schema_id": { "const": "agent-task-runtime-bootstrap/v1" },
        "package": { "$ref": "current-package-ref/v1" },
        "accept_request": { "$ref": "agent-task-accept-request/v1" },
        "accept_response": { "$ref": "agent-task-accept-response/v1" },
        "authority": { "$ref": "server-authority-envelope/v1" },
        "transport_binding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "outer_job_id",
            "run_id",
            "lease_id",
            "transport_attempt_id",
            "transport_epoch"
          ],
          "properties": {
            "outer_job_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "run_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "lease_id": {
              "type": "string",
              "pattern": "^lease_[0-9a-f]{32}$"
            },
            "transport_attempt_id": {
              "type": "string",
              "pattern": "^transport_attempt_[0-9a-f]{32}$"
            },
            "transport_epoch": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          }
        },
        "construction_roots": {
          "type": "object",
          "additionalProperties": false,
          "required": ["task_record", "attempt", "owner"],
          "properties": {
            "task_record": { "$ref": "task-record/v1" },
            "attempt": { "$ref": "attempt-record/v1" },
            "owner": { "$ref": "task-owner/v1" }
          }
        },
        "bootstrap_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  ],
