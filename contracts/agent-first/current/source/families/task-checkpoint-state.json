{
  "family_id": "task-checkpoint-state",
  "schemas": [
    {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "machine-checkpoint/v1",
      "type": "object",
      "additionalProperties": false,
      "x-pullwise-digest": {
        "field": "machine_checkpoint_digest",
        "domain": "pullwise:machine-checkpoint:v1"
      },
      "x-pullwise-semantics": {
        "document_rules": ["machine_checkpoint"],
        "contextual_helpers": []
      },
      "required": [
        "schema_id",
        "package",
        "task_id",
        "generation",
        "task_version",
        "attempt_id",
        "native_epoch",
        "owner_id",
        "owner_epoch",
        "session_id",
        "transport_binding",
        "runtime_thread_id",
        "workspace_state_ref",
        "execution_state_ref",
        "in_flight_tool_invocation_ids",
        "budget_watermark",
        "effect_watermark",
        "observation_watermark",
        "event_seq",
        "created_at",
        "machine_checkpoint_digest"
      ],
      "properties": {
        "schema_id": { "const": "machine-checkpoint/v1" },
        "package": { "$ref": "current-package-ref/v1" },
        "task_id": {
          "type": "string",
          "pattern": "^task_[0-9a-f]{32}$"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "task_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "attempt_id": {
          "type": "string",
          "pattern": "^attempt_[0-9a-f]{32}$"
        },
        "native_epoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "owner_id": {
          "type": "string",
          "pattern": "^owner_[0-9a-f]{32}$"
        },
        "owner_epoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "session_id": {
          "type": "string",
          "pattern": "^sess_[0-9a-f]{32}$"
        },
        "transport_binding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "outer_job_id",
            "run_id",
            "lease_id",
            "transport_epoch"
          ],
          "properties": {
            "outer_job_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "run_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "lease_id": {
              "type": "string",
              "pattern": "^lease_[0-9a-f]{32}$"
            },
            "transport_epoch": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          }
        },
        "runtime_thread_id": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 160
        },
        "workspace_state_ref": {
          "$ref": "content-ref/v1",
          "x-pullwise-content-schema-id": "source-tree-manifest/v1"
        },
        "execution_state_ref": {
          "$ref": "content-ref/v1",
          "x-pullwise-content-schema-id": "execution-state-manifest/v1"
        },
        "in_flight_tool_invocation_ids": {
          "type": "array",
          "maxItems": 0,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^invoke_[0-9a-f]{32}$"
          }
        },
        "budget_watermark": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "effect_watermark": { "const": 0 },
        "observation_watermark": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "event_seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "created_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "machine_checkpoint_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "semantic-checkpoint/v1",
      "type": "object",
      "additionalProperties": false,
      "x-pullwise-digest": {
        "field": "semantic_checkpoint_digest",
        "domain": "pullwise:semantic-checkpoint:v1"
      },
      "x-pullwise-semantics": {
        "document_rules": ["semantic_checkpoint"],
        "contextual_helpers": []
      },
      "required": [
        "schema_id",
        "package",
        "task_id",
        "generation",
        "task_version",
        "owner_id",
        "owner_epoch",
        "task_request_ref",
        "charter_ref",
        "requirement_ledger_ref",
        "owner_summary",
        "pending_interaction_ids",
        "proposal_round",
        "evidence_refs",
        "created_at",
        "semantic_checkpoint_digest"
      ],
      "properties": {
        "schema_id": { "const": "semantic-checkpoint/v1" },
        "package": { "$ref": "current-package-ref/v1" },
        "task_id": {
          "type": "string",
          "pattern": "^task_[0-9a-f]{32}$"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "task_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "owner_id": {
          "type": "string",
          "pattern": "^owner_[0-9a-f]{32}$"
        },
        "owner_epoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "task_request_ref": {
          "$ref": "content-ref/v1",
          "x-pullwise-content-schema-id": "task-request/v1"
        },
        "charter_ref": {
          "oneOf": [
            {
              "$ref": "content-ref/v1",
              "x-pullwise-content-schema-id": "task-charter/v1"
            },
            { "type": "null" }
          ]
        },
        "requirement_ledger_ref": {
          "$ref": "content-ref/v1",
          "x-pullwise-content-schema-id": "requirement-ledger/v1"
        },
        "owner_summary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "objective_restated",
            "completed_requirement_ids",
            "next_requirement_ids",
            "unresolved_question_ids",
            "residual_risk_ids"
          ],
          "properties": {
            "objective_restated": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384
            },
            "completed_requirement_ids": {
              "type": "array",
              "maxItems": 256,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^req_(?:user_objective|user_acceptance|user_constraint|delivery|policy|interaction|derived)_[0-9a-f]{64}$"
              }
            },
            "next_requirement_ids": {
              "type": "array",
              "maxItems": 256,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^req_(?:user_objective|user_acceptance|user_constraint|delivery|policy|interaction|derived)_[0-9a-f]{64}$"
              }
            },
            "unresolved_question_ids": {
              "type": "array",
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^interaction_[0-9a-f]{32}$"
              }
            },
            "residual_risk_ids": {
              "type": "array",
              "maxItems": 256,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^risk_[0-9a-f]{32}$"
              }
            }
          }
        },
        "pending_interaction_ids": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^interaction_[0-9a-f]{32}$"
          }
        },
        "proposal_round": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "evidence_refs": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "$ref": "content-ref/v1" }
        },
        "created_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "semantic_checkpoint_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  ],
