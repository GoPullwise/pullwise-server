{
  "family_id": "task-result-transport-ack",
  "schemas": [
    {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "task-result-transport-ack/v1",
      "type": "object",
      "additionalProperties": false,
      "x-pullwise-digest": {
        "field":"ack_digest",
        "domain":"pullwise:task-result-transport-ack:v1"
      },
      "x-pullwise-semantics": {
        "document_rules":["task_result_transport_ack"],
        "contextual_helpers":["verify_task_result_transport_ack"]
      },
      "required": [
        "schema_id", "package", "result_id", "task_id", "outcome",
        "published_from_version", "terminal_task_version",
        "transport_envelope_digest", "receipt_binding_state",
        "receipt_digest", "accepted_at", "ack_digest"
      ],
      "properties": {
        "schema_id": {"const":"task-result-transport-ack/v1"},
        "package": {"$ref":"current-package-ref/v1"},
        "result_id": {"type":"string","pattern":"^result_[0-9a-f]{32}$"},
        "task_id": {"type":"string","pattern":"^task_[0-9a-f]{32}$"},
        "outcome": {
          "enum":[
            "BLOCKED", "CANCELLED", "CANCELLED_WITH_EFFECTS", "COMPLETED",
            "COMPLETED_WITH_WAIVERS", "FAILED", "NO_CHANGE_NEEDED",
            "PARTIAL", "TERMINATED_WITH_UNKNOWN_EFFECTS"
          ]
        },
        "published_from_version": {
          "type":"integer","minimum":1,"maximum":9007199254740990
        },
        "terminal_task_version": {
          "type":"integer","minimum":2,"maximum":9007199254740991
        },
        "transport_envelope_digest": {
          "type":"string","pattern":"^[0-9a-f]{64}$"
        },
        "receipt_binding_state": {"enum":["bound","not_applicable"]},
        "receipt_digest": {
          "oneOf":[
            {"type":"string","pattern":"^[0-9a-f]{64}$"},
            {"type":"null"}
          ]
        },
        "accepted_at": {
          "type":"string",
          "pattern":"^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?Z$"
        },
        "ack_digest": {"type":"string","pattern":"^[0-9a-f]{64}$"}
      },
      "oneOf": [
        {
          "properties": {
            "receipt_binding_state":{"const":"bound"},
            "receipt_digest":{"type":"string"}
          }
        },
        {
          "properties": {
            "receipt_binding_state":{"const":"not_applicable"},
            "receipt_digest":{"type":"null"}
          }
        }
      ]
    }
  ],
