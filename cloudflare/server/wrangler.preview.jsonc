{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pullwise-server-preview",
  "main": "src/entry.py",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["python_workers"],
  "workers_dev": false,
  "preview_urls": false,
  "account_id": "84e421f26c708c0cf437e287eed11fa1",
  "routes": [{"pattern": "preview-api.pull-wise.com", "custom_domain": true}],
  "vars": {
    "PULLWISE_D1_ACCESS_ENABLED": "1",
    "PULLWISE_PREVIEW_PRODUCT_ENABLED": "1",
    "PULLWISE_PREVIEW_SCHEMA_UPGRADE_ENABLED": "1",
    "PULLWISE_PREVIEW_SCHEMA_V6_UPGRADE_ENABLED": "1",
    "PULLWISE_PREVIEW_SCHEMA_V7_UPGRADE_ENABLED": "1",
    "PULLWISE_PREVIEW_SCHEMA_V8_UPGRADE_ENABLED": "1",
    "PULLWISE_PREVIEW_SCHEMA_V9_UPGRADE_ENABLED": "1",
    "PULLWISE_PREVIEW_SCHEMA_V10_UPGRADE_ENABLED": "1",
    "PULLWISE_RECURRING_EXPENSES_ENABLED": "1",
    "PULLWISE_MODE": "preview",
    "PULLWISE_EMAIL_AUTH_ENABLED": "1",
    "PULLWISE_EMAIL_FROM": "login@auth.pull-wise.com",
    "PULLWISE_APP_URL": "https://preview.pull-wise.com",
    "PULLWISE_GITHUB_CALLBACK_URL": "https://preview.pull-wise.com/api/auth/github/callback",
    "PULLWISE_GITHUB_CLIENT_ID": "Iv23liUTSufy2U2Dc5l7",
    "PULLWISE_GITHUB_APP_SLUG": "gopullwise-preview",
    "PULLWISE_CREEM_API_BASE_URL": "https://test-api.creem.io",
    "PULLWISE_CREEM_PRODUCT_IDS_JSON": "{\"pro\":{\"month\":\"prod_2kANs8l1anpnmBrUUUH1YD\",\"year\":\"prod_ZzDm2l5pwY6Jf8Ye6Mxe1\"},\"max\":{\"month\":\"prod_5DCXPWArAWG9i8NPcFGkbE\",\"year\":\"prod_UZzZ6JSNwziS7857f28k9\"}}",
    "PULLWISE_ALLOWED_ORIGINS": "https://preview.pull-wise.com",
    "PULLWISE_COOKIE_SAME_SITE": "None",
    "PULLWISE_PLAN_LIMITS_JSON": "{\"free\":{\"projects\":3,\"records\":500,\"writesPerMinute\":10,\"writesPerMonth\":1000,\"jevMonthlyBudgetUsd\":\"0.00\"},\"pro\":{\"projects\":100,\"records\":20000,\"writesPerMinute\":60,\"writesPerMonth\":10000,\"jevMonthlyBudgetUsd\":\"3.00\"},\"max\":{\"projects\":100,\"records\":20000,\"writesPerMinute\":60,\"writesPerMonth\":10000,\"jevMonthlyBudgetUsd\":\"5.00\"}}",
    "PULLWISE_JEV_SUGGESTIONS_ENABLED": "1",
    "PULLWISE_JEV_SUGGESTIONS_EVALUATED": "1"
  },
  "send_email": [{"name": "EMAIL", "allowed_sender_addresses": ["login@auth.pull-wise.com"]}],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "pullwise-ledger-preview",
    "database_id": "e9dc3b89-f81f-4fce-87ef-d8797d879fb4",
    "migrations_dir": "migrations"
  }],
  "triggers": {"crons": ["0 * * * *"]},
  "durable_objects": {"bindings": [{"name": "VALIDATION_BUDGET", "class_name": "ValidationBudget"}]},
  "migrations": [{"tag": "validation-budget-v1", "new_sqlite_classes": ["ValidationBudget"]}]
}
